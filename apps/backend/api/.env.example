# LOCAL DEVELOPMENT ONLY. Copy to apps/backend/api/.env and set your own values.
# The .env file is ignored by Git and should never contain production secrets.
CUEBIK_DEBUG=1
CUEBIK_SECRET_KEY=replace-this-with-a-unique-local-development-value
CUEBIK_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cuebik_dev
POSTGRES_USER=cuebik_dev
POSTGRES_PASSWORD=replace-with-your-own-local-database-password
